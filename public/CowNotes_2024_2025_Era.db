    {
      "id": "imported_2425_1c0cbcc7c53c",
      "folderId": "notes",
      "title": "I TAKE PICTURES",
      "content": "I TAKE PICTURES<br>SO THAT WHEN I MISS SOMETHING I JUST<br>LOOK UPON THE<br>PICTURE<br>AND REMEMBER THAT THERE IS SOMETHING<br>GOOD IN LIFE - THE MEMORIES",
      "plainText": "I TAKE PICTURES\nSO THAT WHEN I MISS SOMETHING I JUST\nLOOK UPON THE\nPICTURE\nAND REMEMBER THAT THERE IS SOMETHING\nGOOD IN LIFE - THE MEMORIES",
      "pinned": false,
